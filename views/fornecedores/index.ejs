<%- include("../partials/header") %>
<%- include("../partials/nav") %>

<div class="container mt-5">
    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <div>

            <h1>Fornecedores</h1>

            <p class="text-muted">
                Lista dos fornecedores cadastrados
            </p>

        </div>

        <a href="fornecedores/cadastro" class="btn btn-primary">

            + Novo Fornecedor
        </a>
    </div>
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover
                              align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>CNPJ</th>
                            <th>Email</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% fornecedores.forEach(mostrar => { %>
                        <tr>
                            <td><%= mostrar.id %></td>
                            <td><%= mostrar.cnpj %></td>
                            <td><%= mostrar.email %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<%- include("../partials/footer") %>